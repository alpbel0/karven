# App
APP_ENV=development

# Compose profiles — which service groups `docker compose up` starts.
# Empty now = default stack only: postgres, minio, migrator, api, core-scheduler.
# Later phases: graph (neo4j, Phase 3), queue (redis/worker/beat, Task 1.5/1.7),
# web (frontend, Phase 4-5). Example: COMPOSE_PROFILES=graph,queue
COMPOSE_PROFILES=

# LLM providers
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_MODEL=deepseek-v4.1-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# LLM tunables
LLM_REQUEST_TIMEOUT_S=180
LLM_MAX_TOKENS=16000
LLM_RETRY_WAITS_S=15,30,60,120
LLM_MAX_TOTAL_WAIT_S=600
LLM_TRANSIENT_ATTEMPTS=2

# Core scheduler (Task 1.4d). The core-scheduler container loops one tick every
# CORE_TICK_MINUTES and writes its heartbeat to CORE_HEARTBEAT_PATH (the compose
# healthcheck fails when the file is missing or older than 3 ticks). The release
# calendar is re-synced when its newest fetched_at is older than
# CORE_CALENDAR_REFRESH_HOURS (never more often than CORE_RETRY_HOURS).
CORE_TICK_MINUTES=15
CORE_CALENDAR_REFRESH_HOURS=24
CORE_HEARTBEAT_PATH=/tmp/core-scheduler.heartbeat

# On-demand fetch queue (Task 1.5). The `queue` profile's Celery worker/beat use
# these: a running job writes its heartbeat every FETCH_HEARTBEAT_INTERVAL_SECONDS
# and is declared stalled only after FETCH_HEARTBEAT_STALL_MINUTES without a beat
# (no fixed cap); the beat runs the watchdog every FETCH_WATCHDOG_INTERVAL_SECONDS.
# FETCH_WORKER_CONCURRENCY is the worker's --concurrency. A failed on-demand job
# is diagnosed by the data-fetch agent (Task 1.6); FETCH_AGENT_MAX_ROUNDS is the
# number of diagnosis rounds allowed per job chain (>= 1). The first failed job
# is round 1; a retry it opens is round 2, which may be diagnosed but cannot
# request another retry.
FETCH_HEARTBEAT_STALL_MINUTES=5
FETCH_HEARTBEAT_INTERVAL_SECONDS=30
FETCH_WATCHDOG_INTERVAL_SECONDS=60
FETCH_WORKER_CONCURRENCY=2
FETCH_AGENT_MAX_ROUNDS=2

# Catalog series search (Task 2.4). A Jev 1-5 score passes when
# p(4)+p(5) >= SEARCH_PASS_PROBABILITY; a dimension choice below
# SEARCH_LOW_CONFIDENCE triggers EVREN rewrites. Candidate datasets are scored
# SEARCH_DATASET_CHUNK questions per Jev call; at most SEARCH_MAX_DATASETS
# datasets and SEARCH_MAX_RESULTS series are returned. A series frequency is
# compatible when the Jev yes-probability is at least SEARCH_FREQUENCY_FLOOR.
# When no series is strong, datasets rated at least
# SEARCH_NEAR_MISS_PROBABILITY are offered as near-miss candidates, at most
# SEARCH_NEAR_MISS_DATASETS of them.
SEARCH_PASS_PROBABILITY=0.60
SEARCH_LOW_CONFIDENCE=0.60
SEARCH_DATASET_CHUNK=50
SEARCH_MAX_DATASETS=5
SEARCH_MAX_RESULTS=3
SEARCH_FREQUENCY_FLOOR=0.40
SEARCH_NEAR_MISS_PROBABILITY=0.15
SEARCH_NEAR_MISS_DATASETS=2

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=karven
POSTGRES_USER=karven
POSTGRES_PASSWORD=

# Neo4j
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Graph migrations. Set to true exactly when the `graph` profile is enabled
# (COMPOSE_PROFILES contains `graph`); otherwise the migrator skips Neo4j and
# logs `neo4j: disabled (NEO4J_ENABLED=false), graph migrations skipped`.
NEO4J_ENABLED=false

# Redis
REDIS_URL=redis://127.0.0.1:16379/0

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=karven
MINIO_SECRET_KEY=
MINIO_BUCKET_RAW=karven-raw

# Admin
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# NOTE: the DB/Redis/MinIO values above are HOST-SIDE (127.0.0.1 + the mapped
# host ports). docker compose overrides the host/port with in-network service
# names for containers. Secrets stay empty here; fill them in the real .env.

# Data sources (fill yourself; never commit real values)
TUIK_API_KEY=
TCMB_EVDS_API_KEY=
