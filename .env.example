# App
APP_ENV=development

# Compose profiles — which service groups `docker compose up` starts.
# Empty now = default stack only: postgres, minio, migrator, api.
# Later phases: graph (neo4j, Phase 3), queue (redis/worker/beat, Task 1.5/1.7),
# web (frontend, Phase 4-5). Example: COMPOSE_PROFILES=graph,queue
COMPOSE_PROFILES=

# LLM providers
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_MODEL=deepseek-v4.1-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# LLM tunables
LLM_REQUEST_TIMEOUT_S=180
LLM_MAX_TOKENS=16000
LLM_RETRY_WAITS_S=15,30,60,120
LLM_MAX_TOTAL_WAIT_S=600
LLM_TRANSIENT_ATTEMPTS=2

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=karven
POSTGRES_USER=karven
POSTGRES_PASSWORD=

# Neo4j
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Graph migrations. Set to true exactly when the `graph` profile is enabled
# (COMPOSE_PROFILES contains `graph`); otherwise the migrator skips Neo4j and
# logs `neo4j: disabled (NEO4J_ENABLED=false), graph migrations skipped`.
NEO4J_ENABLED=false

# Redis
REDIS_URL=redis://127.0.0.1:16379/0

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=karven
MINIO_SECRET_KEY=
MINIO_BUCKET_RAW=karven-raw

# Admin
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# NOTE: the DB/Redis/MinIO values above are HOST-SIDE (127.0.0.1 + the mapped
# host ports). docker compose overrides the host/port with in-network service
# names for containers. Secrets stay empty here; fill them in the real .env.

# Data sources (fill yourself; never commit real values)
TUIK_API_KEY=
TCMB_EVDS_API_KEY=
