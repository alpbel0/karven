# =============================================================================
# TEST-ONLY environment for the isolated integration stack.
# NEVER used for the live stack.
#
# Fixed, deliberately simple credentials so the throwaway `karven-test`
# compose project (its own project name, ports, databases and bucket) is fully
# separated from live and can never touch it.
#
# Usage:
#   docker compose --env-file compose.test.env -p karven-test <command>
# or, in one shot:
#   (from backend/) uv run python scripts/integration.py
# =============================================================================

# Compose project + image tag (live uses project `karven` and tag `dev`).
COMPOSE_PROJECT_NAME=karven-test
BACKEND_IMAGE_TAG=test
APP_ENV=test
APP_ENV_FILE=compose.test.env

# Host ports (live defaults: 15432, 17474, 17687, 16379, 19000, 19001, 18000).
POSTGRES_HOST_PORT=25432
NEO4J_HTTP_HOST_PORT=27474
NEO4J_BOLT_HOST_PORT=27687
REDIS_HOST_PORT=26379
MINIO_API_HOST_PORT=29000
MINIO_CONSOLE_HOST_PORT=29001
API_HOST_PORT=28000

# Databases / bucket.
POSTGRES_DB=karven_test
POSTGRES_USER=karven
MINIO_ACCESS_KEY=karven
MINIO_BUCKET_RAW=karven-test-raw
NEO4J_USER=neo4j

# Fixed test-only passwords (not secrets; never reused for live).
POSTGRES_PASSWORD=test-only-postgres-pw
NEO4J_PASSWORD=test-only-neo4j-pw
MINIO_SECRET_KEY=test-only-minio-secret

# Host-side connection values for the test process (127.0.0.1 + test ports).
# Containers get in-network hostnames via compose `environment:` overrides.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=25432
NEO4J_URI=bolt://127.0.0.1:27687
REDIS_URL=redis://127.0.0.1:26379/0
MINIO_ENDPOINT=http://127.0.0.1:29000
